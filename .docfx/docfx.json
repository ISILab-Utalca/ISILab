{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../../../",
          "files": [
            "Commons.csproj",
            "DevTools.csproj",
            "LBS.csproj",
            "LBS.Editor",
            "PathOSPlus.csproj",
            "ReorderableList.csproj"
          ]
        }
      ],
      "dest": "api_doc",
      "shouldSkipMarkup": true
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "en/**/*.md",
          "en/**/**/*.md",
          "en/**/toc.yml",
          "es/**/*.md",
          "es/**/*.md",
          "es/**/toc.yml",
          "api_doc/**.yml",
          "api_doc/toc.yml",
          "toc.yml",
          "index.md"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "templates"
    ],
    "globalMetadata": {
      "_appName": "Level Building Sidekick",
      "_appTitle": "Level Building Sidekick",
      "_enableSearch": true,
      "pdf": false,
      "_appLogoPath": "/images/logo.svg",
      "_appFaviconPath": "/images/favicon.ico"
    }
  }
}