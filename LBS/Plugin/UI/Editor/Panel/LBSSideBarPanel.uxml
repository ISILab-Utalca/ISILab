<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Assets/ISILab/LBS/Plugin/UI/Styles/LBSstyle.uss?fileID=7433441132597879392&amp;guid=9614f5340894b3546b59d43b5f2be029&amp;type=3#LBSstyle" />
    <ISILab.LBS.CustomComponents.LBSToolbar name="ExtraToolsBar" toolbar-accent-color="DARKEST" class="vertical prop-darkest-bg" style="width: 40px; border-bottom-width: 0; border-top-width: 0;">
        <ui:VisualElement name="FloatingPanelButtonContainer" style="flex-grow: 0; flex-direction: column; justify-content: flex-end;">
            <ui:Toggle value="false" focusable="true" name="PlusToggle" class="lbs-tool-button-toggle" style="flex-direction: row; height: 40px; display: none; background-image: resource(&apos;Icons/Vectorial/QuestIcons/GrammarAssistant/Icon=Add&apos;);">
                <ISILab.LBS.CustomComponents.LBSCustomImage style="background-image: resource(&apos;Icons/Vectorial/QuestIcons/GrammarAssistant/Icon=Add&apos;); min-width: 32px; max-width: 32px; min-height: 32px; max-height: 32px;" />
            </ui:Toggle>
            <ui:Toggle value="false" focusable="true" name="LayerToggle" tooltip="Layers Panel" class="lbs-tool-button-toggle" style="flex-direction: row-reverse; color: rgb(58, 58, 58); height: 40px; width: auto; background-image: resource(&apos;Icons/Vectorial/SideToolBar/Layer_Panel_Icon&apos;); background-size: 85% 85%;" />
            <ui:Toggle value="false" focusable="true" name="QAssisToggle" tooltip="Quick Assistant Panel" class="lbs-tool-button-toggle" style="flex-direction: row-reverse; color: rgb(58, 58, 58); height: 40px; width: auto; background-image: url(&quot;project://database/Assets/ISILab/LBS/Plugin/UI/Editor/FloatingPanels/QuickAssistantPanel/QuickAssistantRobot.svg?fileID=7388822144124034973&amp;guid=9bb39f5c43af73c44b40481f864bacef&amp;type=3#QuickAssistantRobot&quot;); background-size: 70% 70%;" />
            <ui:Toggle value="false" focusable="true" name="Gen3DToggle" tooltip="3D Generator Panel " class="lbs-tool-button-toggle" style="flex-direction: row; height: 40px; background-image: resource(&apos;Icons/Vectorial/SideToolBar/3D_Icon_Vector&apos;); background-size: 85% 85%;" />
        </ui:VisualElement>
        <ui:VisualElement name="Separator" class="lbs-horizontal-divider" />
        <ui:VisualElement name="ToggleButtonContainer" style="flex-grow: 1; flex-direction: column; justify-content: flex-start; align-self: stretch;">
            <ui:Toggle value="false" focusable="true" name="BehaviourButton" tooltip="Palette" class="lbs-tool-button-toggle lbs-tab-button" style="flex-direction: row; display: flex;">
                <ISILab.LBS.CustomComponents.LBSCustomImage style="background-image: resource(&apos;Icons/Vectorial/SideToolBar/Icon=Palette&apos;); min-width: 24px; max-width: 24px; max-height: 24px; min-height: 24px; -unity-background-scale-mode: scale-to-fit; align-self: center;" />
            </ui:Toggle>
            <ui:Toggle value="false" focusable="true" name="AssistantButton" tooltip="AI Assistant" class="lbs-tool-button-toggle lbs-tab-button" style="flex-direction: row; display: flex; align-self: stretch;">
                <ISILab.LBS.CustomComponents.LBSCustomImage style="background-image: resource(&apos;Icons/Vectorial/SideToolBar/Icon=AI_Assistant&apos;); -unity-background-scale-mode: scale-to-fit; min-width: 24px; max-width: 24px; max-height: 24px; min-height: 24px; align-self: center;" />
            </ui:Toggle>
            <ui:Toggle value="false" focusable="true" name="LayerDataButton" tooltip="Layer Data" class="lbs-tool-button-toggle lbs-tab-button" style="flex-direction: row; display: flex;">
                <ISILab.LBS.CustomComponents.LBSCustomImage style="background-image: resource(&apos;Icons/Vectorial/SideToolBar/Icon=LayerData&apos;); -unity-background-scale-mode: scale-to-fit; min-width: 24px; min-height: 24px; max-height: 24px; max-width: 24px; align-self: center;" />
            </ui:Toggle>
        </ui:VisualElement>
        <ui:VisualElement name="Separator" class="lbs-horizontal-divider" />
        <ui:VisualElement name="WindowsButtonContainer" style="flex-grow: 0; flex-direction: column; justify-content: flex-end;">
            <ui:Toggle value="false" focusable="true" name="BlueprintButton" tooltip="Blueprints" class="lbs-tool-button-toggle lbs-tab-button" style="width: 36px; height: 36px;">
                <ISILab.LBS.CustomComponents.LBSCustomImage style="background-image: resource(&apos;Icons/Vectorial/Blueprints/Icon=BlueprintMode&apos;); min-width: 24px; max-width: 24px; max-height: 24px; min-height: 24px; align-self: center;" />
            </ui:Toggle>
            <ui:Toggle value="false" focusable="true" name="BundlesButton" tooltip="Bundles" class="lbs-tool-button-toggle lbs-tab-button" style="width: 36px; height: 36px;">
                <ISILab.LBS.CustomComponents.LBSCustomImage style="background-image: resource(&apos;Icons/Vectorial/UpperToolBar/Icon=BundleIcon&apos;); min-width: 24px; max-width: 24px; max-height: 24px; min-height: 24px; align-self: center;" />
            </ui:Toggle>
            <ui:Toggle value="false" focusable="true" name="TagsButton" tooltip="Tags" class="lbs-tool-button-toggle lbs-tab-button" style="flex-direction: row; height: 40px; display: flex;">
                <ISILab.LBS.CustomComponents.LBSCustomImage style="background-image: resource(&apos;Icons/Vectorial/Population/Icon=DogTag&apos;); max-width: 24px; min-width: 24px; min-height: 24px; max-height: 24px; align-self: center;" />
            </ui:Toggle>
        </ui:VisualElement>
    </ISILab.LBS.CustomComponents.LBSToolbar>
</ui:UXML>
