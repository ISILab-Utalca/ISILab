<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Assets/ISILab/LBS/Plugin/UI/Styles/LBSstyle.uss?fileID=7433441132597879392&amp;guid=9614f5340894b3546b59d43b5f2be029&amp;type=3#LBSstyle" />
    <ui:VisualElement style="flex-grow: 1; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px; justify-content: center; align-self: auto; align-items: center;">
        <ui:VisualElement name="CustomImage" style="flex-grow: 1; position: absolute; align-self: center; background-image: none; background-color: rgba(0, 0, 0, 0); flex-shrink: 0; left: 0; top: 0; right: 0; bottom: 0; display: flex;" />
        <ISILab.LBS.CustomComponents.LBSCustomImage name="LoadingImage" style="background-image: resource(&apos;Icons/Vectorial/Population/MapElites/Icon=ThreeDots&apos;); background-size: contain; -unity-background-scale-mode: scale-to-fit; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; flex-grow: 0; min-width: auto; max-width: none; min-height: auto; max-height: initial; width: 50%; height: auto; align-self: center; align-content: stretch; display: flex; flex-shrink: 0; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;" />
        <ui:VisualElement class="lbs-compact-panel" style="flex-grow: 1; position: absolute; left: 5%; bottom: 5%; width: 50px; height: 24px;">
            <ISILab.LBS.CustomComponents.LBSCustomLabel name="ScoreLabel" text="0.00" style="flex-grow: 1;" />
        </ui:VisualElement>
        <ui:VisualElement name="SelectBorder" style="flex-grow: 0; position: absolute; min-width: auto; width: 100%; height: 100%; flex-shrink: 0; justify-content: space-between; align-self: center; align-content: center; border-left-color: rgb(81, 112, 202); border-right-color: rgb(81, 112, 202); border-top-color: rgb(81, 112, 202); border-bottom-color: rgb(81, 112, 202); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; display: flex;">
            <uie:ToolbarMenu tabindex="-1" display-tooltip-when-elided="true" name="ToolBar" picking-mode="Ignore" class="lbs-unity-foldout__toggle" style="position: absolute; top: 0; left: 0; width: 100%; background-color: rgba(60, 60, 60, 0); border-left-color: rgba(35, 35, 35, 0); border-right-color: rgba(35, 35, 35, 0); border-top-color: rgba(35, 35, 35, 0); border-bottom-color: rgba(35, 35, 35, 0); height: 100%; flex-grow: 0; align-items: stretch; justify-content: center; align-self: stretch; flex-direction: column; flex-wrap: wrap; overflow: visible; align-content: center; flex-shrink: 0;" />
            <ui:Button name="SelectButton" style="width: 100%; height: 100%; background-color: rgba(88, 88, 88, 0); align-self: center; border-left-color: rgb(43, 45, 99); border-top-color: rgb(43, 45, 99); border-right-color: rgb(43, 45, 99); border-bottom-color: rgb(43, 45, 99); border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-right-radius: 2px; border-bottom-left-radius: 2px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; align-content: auto; justify-content: space-between; align-items: center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
        </ui:VisualElement>
        <ui:VisualElement name="InactiveBorder" style="flex-grow: 0; position: absolute; min-width: auto; width: 100%; height: 100%; flex-shrink: 0; justify-content: space-between; align-self: center; align-content: center; border-left-color: rgba(0, 0, 0, 0.18); border-right-color: rgba(0, 0, 0, 0.18); border-top-color: rgba(0, 0, 0, 0.18); border-bottom-color: rgba(0, 0, 0, 0.18); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; display: flex;" />
    </ui:VisualElement>
</ui:UXML>
