    <ui:VisualElement name="Panel" class="SubBackground lbs-default-container-panel" style="margin-left: 0; margin-right: 0; flex-grow: 1; margin-top: 0; margin-bottom: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
        <ui:VisualElement name="Header" class="lbs-group-box" style="flex-shrink: 0; margin-left: 4px; margin-right: 4px; margin-top: 4px; margin-bottom: 4px; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; flex-direction: row; height: 30px; align-self: stretch; align-items: stretch; align-content: auto; justify-content: flex-start; background-color: rgba(35, 35, 35, 0.2); border-left-color: rgb(35, 35, 35); border-right-color: rgb(35, 35, 35); border-top-color: rgb(35, 35, 35); border-bottom-color: rgb(35, 35, 35);">
            <ui:VisualElement class="lbs-sub-background" style="flex-grow: 1; flex-direction: row; min-width: 50px; max-width: 50px; height: 100%; min-height: 100%; max-height: 100%; align-content: auto; align-self: stretch; align-items: center; justify-content: space-around;">
