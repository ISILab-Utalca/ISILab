<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Reset" style="flex-grow: 0; background-image: resource(&apos;Icons/Vectorial/Population/MapElites/Icon=Retry&apos;); width: 40px; height: 40px; flex-shrink: 0; -unity-background-image-tint-color: rgb(78, 239, 188); align-self: center; position: absolute; align-items: center; align-content: center; justify-content: center;" />
    <ui:VisualElement name="Draggable" style="flex-grow: 0; border-top-left-radius: 10000px; border-top-right-radius: 10000px; border-bottom-right-radius: 10000px; border-bottom-left-radius: 10000px; position: relative; flex-shrink: 0; width: 48px; height: 48px; translate: 0 0; align-self: center; align-content: center; align-items: center; justify-content: center;">
        <ui:VisualElement name="ModSelector" picking-mode="Ignore" style="flex-grow: 1; position: absolute; overflow: visible; visibility: visible; align-self: center; justify-content: space-around; align-items: center; align-content: center; display: flex;">
            <ui:VisualElement picking-mode="Ignore" name="ModBackground" style="flex-grow: 1; position: relative; background-image: resource(&apos;Icons/Vectorial/Icon=Circle&apos;); background-size: 100% 100%; background-color: rgba(0, 0, 0, 0); width: 75px; height: 75px; overflow: visible; visibility: visible; align-self: center; justify-content: space-around; align-items: center; align-content: center; -unity-background-image-tint-color: rgb(32, 55, 217); display: flex;" />
            <ui:Button name="1" style="width: 25px; height: 25px; position: absolute; background-image: resource(&apos;Icons/Vectorial/Population/Icon=Scroll&apos;); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; -unity-background-image-tint-color: rgb(78, 239, 188); background-color: rgba(88, 88, 88, 0); align-items: center; align-self: center; align-content: center; justify-content: center; display: flex; left: auto; top: 25px; right: 65px;" />
            <ui:Button name="2" style="width: 25px; height: 25px; position: absolute; background-image: resource(&apos;Icons/Vectorial/Population/Icon=Hearth&apos;); -unity-background-image-tint-color: rgb(78, 239, 188); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgba(88, 88, 88, 0); align-items: center; justify-content: center; align-self: center; align-content: center; display: flex; top: 67px;" />
            <ui:Button name="3" style="width: 25px; height: 25px; background-image: resource(&apos;Icons/Vectorial/Population/Icon=Helmet&apos;); -unity-background-image-tint-color: rgb(78, 239, 188); background-color: rgba(88, 88, 88, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; align-items: center; justify-content: center; align-self: center; align-content: center; position: absolute; display: flex; top: 25px; left: 65px;" />
            <ui:Button name="4" style="width: 25px; height: 25px; background-image: resource(&apos;Icons/Vectorial/SideToolBar/Icon=AI_Assistant&apos;); -unity-background-image-tint-color: rgb(78, 239, 188); background-color: rgba(88, 88, 88, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; align-items: center; justify-content: center; align-content: center; align-self: center; position: absolute; display: flex; bottom: 67px;" />
        </ui:VisualElement>
        <ui:VisualElement name="Icon" style="flex-grow: 0; background-image: resource(&apos;Icons/Vectorial/SideToolBar/Icon=AI_Assistant&apos;); width: 50%; height: 50%; flex-shrink: 1; -unity-background-image-tint-color: rgb(78, 239, 188); align-self: center; align-content: center; align-items: center; justify-content: center;" />
    </ui:VisualElement>
</ui:UXML>
