<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Reset" style="flex-grow: 0; background-image: resource(&apos;Icons/Vectorial/Population/MapElites/Icon=Retry&apos;); width: 40px; height: 40px; flex-shrink: 0; -unity-background-image-tint-color: rgb(78, 239, 188); align-self: center; position: absolute; align-items: center; align-content: center; justify-content: center;" />
    <ui:VisualElement name="Draggable" style="flex-grow: 0; border-top-left-radius: 10000px; border-top-right-radius: 10000px; border-bottom-right-radius: 10000px; border-bottom-left-radius: 10000px; position: relative; flex-shrink: 0; width: 40px; height: 40px; align-self: center; align-content: center; align-items: center; justify-content: center;">
        <ui:VisualElement name="ModSelector" picking-mode="Ignore" style="flex-grow: 1; position: absolute; overflow: visible; visibility: visible; align-self: center; justify-content: center; align-items: center; align-content: stretch; display: flex; width: 125px; height: 125px; flex-direction: column;">
            <ui:VisualElement picking-mode="Ignore" name="ModBackground" style="flex-grow: 0; position: relative; background-image: resource(&apos;Icons/Shape=Translucent_Circle&apos;); background-size: 100% 100%; background-color: rgba(0, 0, 0, 0); overflow: visible; visibility: visible; align-self: center; justify-content: center; align-items: center; align-content: center; -unity-background-image-tint-color: rgb(78, 239, 188); display: flex; flex-shrink: 0; width: 44%; height: 44%;" />
            <ui:VisualElement picking-mode="Ignore" name="ModBackground2" style="flex-grow: 1; position: absolute; background-image: resource(&apos;Subtract&apos;); background-size: 100% 100%; background-color: rgba(0, 0, 0, 0); overflow: visible; visibility: visible; align-self: center; justify-content: center; align-items: center; align-content: stretch; -unity-background-image-tint-color: rgb(255, 255, 255); display: flex; width: 100%; height: 100%;" />
            <ui:VisualElement name="ButtonsContainer" style="flex-grow: 1; position: absolute; align-content: center; align-self: center; justify-content: center; align-items: center;" />
        </ui:VisualElement>
        <ui:VisualElement name="Icon" style="flex-grow: 0; background-image: resource(&apos;Icons/Mode=Vanilla&apos;); width: 100%; height: 100%; flex-shrink: 1; -unity-background-image-tint-color: rgb(78, 239, 188); align-self: center; align-content: center; align-items: center; justify-content: center; background-size: 100% 100%; background-position-y: top 0;" />
        <ISILab.LBS.AI.Clippy.VisualElements.LbesinChatbox name="LbesinChatbox" style="width: 150px; height: 40px; position: absolute; left: 0; translate: 80px 0; min-width: 100px; min-height: 20px;" />
    </ui:VisualElement>
</ui:UXML>
