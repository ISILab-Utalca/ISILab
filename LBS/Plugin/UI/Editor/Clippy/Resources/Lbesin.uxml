<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Reset" style="flex-grow: 0; background-image: resource(&apos;Icons/Vectorial/Population/MapElites/Icon=Retry&apos;); width: 48px; height: 48px; flex-shrink: 0; -unity-background-image-tint-color: rgb(78, 239, 188); background-size: 75% 75%; align-self: center;" />
    <ui:VisualElement name="Draggable" style="flex-grow: 0; border-top-left-radius: 10000px; border-top-right-radius: 10000px; border-bottom-right-radius: 10000px; border-bottom-left-radius: 10000px; position: absolute; flex-shrink: 0; width: 48px; height: 48px; translate: 0 0; align-self: center; align-content: center; align-items: center; justify-content: center;">
        <ui:VisualElement name="ModSelector" style="flex-grow: 1; position: absolute; background-image: resource(&apos;Icons/Vectorial/Icon=Circle&apos;); background-size: 100% 100%; background-color: rgba(0, 0, 0, 0); width: 75px; height: 75px; overflow: visible; visibility: visible; align-self: center; justify-content: center; align-items: center; align-content: center; -unity-background-image-tint-color: rgb(32, 55, 217);">
            <ui:VisualElement name="1" style="flex-grow: 0; background-image: resource(&apos;Icons/Vectorial/Population/Icon=Scroll&apos;); width: 20%; height: 20%; flex-shrink: 0; -unity-background-image-tint-color: rgb(78, 239, 188); align-self: center; align-content: center; align-items: center; justify-content: center; left: 8px; position: absolute;" />
            <ui:VisualElement name="2" style="flex-grow: 0; background-image: resource(&apos;Icons/Vectorial/Population/Icon=Hearth&apos;); width: 20%; height: 20%; flex-shrink: 0; -unity-background-image-tint-color: rgb(78, 239, 188); align-self: center; align-content: center; align-items: center; justify-content: center; position: absolute; -unity-background-scale-mode: scale-to-fit; bottom: 8px;" />
            <ui:VisualElement name="3" style="flex-grow: 0; background-image: resource(&apos;Icons/Vectorial/Population/Icon=Helmet&apos;); width: 20%; height: 20%; flex-shrink: 0; -unity-background-image-tint-color: rgb(78, 239, 188); align-self: center; align-content: center; align-items: center; justify-content: center; position: absolute; -unity-background-scale-mode: scale-to-fit; right: 8px;" />
            <ui:VisualElement name="4" style="flex-grow: 0; background-image: resource(&apos;Icons/Vectorial/SideToolBar/Icon=AI_Assistant&apos;); width: 20%; height: 20%; flex-shrink: 0; -unity-background-image-tint-color: rgb(78, 239, 188); align-self: center; align-content: center; align-items: center; justify-content: center; position: absolute; -unity-background-scale-mode: scale-to-fit; top: 8px;" />
        </ui:VisualElement>
        <ui:VisualElement name="Icon" style="flex-grow: 0; background-image: resource(&apos;Icons/Vectorial/SideToolBar/Icon=AI_Assistant&apos;); width: 50%; height: 50%; flex-shrink: 1; -unity-background-image-tint-color: rgb(78, 239, 188); align-self: center; align-content: center; align-items: center; justify-content: center;" />
    </ui:VisualElement>
</ui:UXML>
