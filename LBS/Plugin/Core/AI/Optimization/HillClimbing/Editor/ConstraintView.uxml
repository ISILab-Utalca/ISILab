<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ISILab.LBS.CustomComponents.LBSCustomFoldout name="Foldout">
        <ui:VisualElement style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); flex-direction: row;">
            <ui:VisualElement name="WidthPanel" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); padding-right: 5px;">
                <ISILab.LBS.CustomComponents.LBSCustomLabel text="Width" style="-unity-font-style: bold;" />
                <ui:VisualElement style="flex-grow: 0; background-color: rgba(0, 0, 0, 0); flex-direction: column;">
                    <ISILab.LBS.CustomComponents.LBSCustomFloatField label="Min" name="WidthMin" readonly="false" display-minus="false" display-add="false" style="flex-shrink: 1; flex-grow: 1; justify-content: space-evenly; align-items: flex-end; flex-wrap: nowrap; flex-direction: row; align-self: stretch;" />
                    <ISILab.LBS.CustomComponents.LBSCustomFloatField name="WidthMax" label="Max" display-add="false" display-minus="false" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="HeightPanel" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);">
                <ISILab.LBS.CustomComponents.LBSCustomLabel text="Height" style="-unity-font-style: bold;" />
                <ui:VisualElement style="flex-grow: 0; background-color: rgba(0, 0, 0, 0); flex-direction: column;">
                    <ISILab.LBS.CustomComponents.LBSCustomFloatField label="Min" name="HeightMin" />
                    <ISILab.LBS.CustomComponents.LBSCustomFloatField name="HeightMax" label="Max" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ISILab.LBS.CustomComponents.LBSCustomFoldout>
</ui:UXML>
