<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/ISILab/LBS/Plugin/UI/Styles/LBSstyle.uss?fileID=7433441132597879392&amp;guid=9614f5340894b3546b59d43b5f2be029&amp;type=3#LBSstyle" />
    <ISILab.LBS.CustomComponents.LBSCustomFoldout text="Presets">
        <ISILab.LBS.CustomComponents.LBSCustomButton name="CopyWeights" text="Capture Weights" tooltip="Reads the tiles weights (generation probability) from the current Layer, and applies them to the Exterior Tile Bundle in use." style="flex-grow: 1; align-self: stretch; max-height: 24px;" />
        <ISILab.LBS.CustomComponents.LBSCustomObjectField label="Current Bundle" type="ISILab.LBS.Plugin.Components.Bundles.Bundle, LBS" icon-side="None" use-custom-filter="false" style="align-items: stretch; justify-content: flex-start; align-self: stretch; margin-top: 1px; margin-bottom: 1px; margin-left: 3px; margin-right: 3px; padding-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0;" />
        <uie:ToolbarSpacer name="ToolbarSpacer" style="height: 2px; width: auto; background-color: rgb(82, 82, 82); background-size: 100% 10%; margin-top: 5px; margin-bottom: 5px; align-self: stretch;" />
        <ISILab.LBS.CustomComponents.LBSCustomTextField label="Preset Name" name="PresetName" style="flex-grow: 1; align-self: stretch; max-height: 24px;" />
        <ISILab.LBS.CustomComponents.LBSCustomTextField label="Save Path" name="PresetsPath" value="Assets//LBS/Artificial Intelligence/Assistants/WFCPresets" placeholder-text="filler text" style="flex-grow: 1; flex-shrink: 1; max-height: 24px; align-self: stretch;" />
        <uie:ToolbarSpacer style="height: 2px; width: auto; background-color: rgb(82, 82, 82); background-size: 100% 10%; margin-top: 5px; margin-bottom: 5px; align-self: stretch;" />
        <ui:VisualElement style="flex-grow: initial; flex-direction: row; align-self: stretch; align-content: auto; justify-content: space-evenly; align-items: stretch; flex-wrap: nowrap;">
            <ISILab.LBS.CustomComponents.LBSCustomButton text="Save Wieghts" name="SaveWeights" tooltip="Saves the captured weights to a new WFC preset, or overrides an existent preset with the same name." style="flex-grow: 1; align-self: stretch; height: 32px;" />
            <ISILab.LBS.CustomComponents.LBSCustomButton name="LoadWeights" text="Load Weights&#10;" tooltip="Loads saved weights from the selected WFC preset from the list below." style="height: 32px; flex-grow: 1;" />
        </ui:VisualElement>
        <ISILab.LBS.CustomComponents.LBSCustomObjectField name="CurrentPreset" label="Current Preset" type="ISILab.LBS.Plugin.Components.Bundles.Bundle, LBS" value="project://database/Assets/ISILab/LBS/Plugin/Core/AI/Assistant/WFCPresets/Default%20WFC%20Preset.asset?fileID=11400000&amp;guid=aa906d6d48e992141b714743bb35ff3a&amp;type=2#Default WFC Preset" />
        <ISILab.LBS.CustomComponents.LBSCustomListView name="PresetsList" header-title="Presets" show-border="true" show-foldout-header="true" show-bound-collection-size="false" item-template="project://database/Assets/ISILab/LBS/Plugin/Core/AI/Assistant/Editor/WFCPresetElement.uxml?fileID=9197481963319205126&amp;guid=993e14f54f69e034ead5a72849f362a8&amp;type=3#WFCPresetElement" style="flex-grow: 0; align-self: stretch;" />
    </ISILab.LBS.CustomComponents.LBSCustomFoldout>
    <ISILab.LBS.CustomComponents.LBSCustomFoldout text="Wave Function Collapse Settings">
        <ISILab.LBS.CustomComponents.LBSCustomToggleField value="true" name="SafeMode" label="Safe Generation" tooltip="It forces the correct generation of all tiles. Deactivating it may cause incomplete generation." style="align-self: stretch; flex-direction: row; align-items: auto; justify-content: space-between; flex-wrap: nowrap; flex-shrink: 1; flex-grow: 0; flex-basis: auto; right: auto; align-content: flex-start; padding-left: 0; padding-right: 0; margin-left: 10px; margin-right: 10px;" />
    </ISILab.LBS.CustomComponents.LBSCustomFoldout>
</ui:UXML>
